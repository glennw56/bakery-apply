# Copy to .env for local runs. Do not commit .env.
# No Square keys. Ever.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme
BAKERY_APPLY_DB=data/app.db
# DATABASE_URL=sqlite:///data/app.db
HOST=127.0.0.1
PORT=8000

# Local default: leave GCS_BUCKET unset → SQLite + data/resumes/
# When GCS_BUCKET and GOOGLE_CLOUD_PROJECT (or GCP_PROJECT) are set:
# users + applications go to Firestore native; resume PDFs to the private GCS bucket.
# Glenn Cloud Run defaults (not secrets — do not put SESSION_SECRET / ADMIN_PASSWORD in git):
# GOOGLE_CLOUD_PROJECT=bakery-444323
# FIRESTORE_DATABASE=(default)
# GCS_BUCKET=bakery-444323-apply-resumes
# FIRESTORE_COLLECTION=applications
# SESSION_HTTPS=1  # optional; Cloud Run sets K_SERVICE and that also enables https_only cookies

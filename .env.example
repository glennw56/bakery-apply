# Copy to .env for local runs. Do not commit .env.
# No Square keys. Ever.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme
BAKERY_APPLY_DB=data/app.db
# DATABASE_URL=sqlite:///data/app.db
HOST=127.0.0.1
PORT=8000

# Local default: leave GCS_BUCKET unset → SQLite + data/resumes/
# When GCS_BUCKET and GOOGLE_CLOUD_PROJECT (or GCP_PROJECT) are set:
# users + applications go to Firestore native; resume PDFs to the private GCS bucket.
# Glenn Cloud Run defaults (not secrets — do not put SESSION_SECRET / ADMIN_PASSWORD in git):
# GOOGLE_CLOUD_PROJECT=bakery-444323
# FIRESTORE_DATABASE=(default)
# GCS_BUCKET=bakery-444323-apply-resumes
# FIRESTORE_COLLECTION=applications
# SESSION_HTTPS=1  # optional; Cloud Run sets K_SERVICE and that also enables https_only cookies

# Applicant Sign in with Google (OAuth 2.0 web client). Do not commit real values.
# Admin stays on ADMIN_EMAIL / ADMIN_PASSWORD. See DEPLOY.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Exact callback registered on the OAuth client. Default if this and PUBLIC_BASE_URL are unset:
# https://bakery-apply-k6uuoen7wa-ue.a.run.app/auth/google/callback
# GOOGLE_REDIRECT_URI=https://bakery-apply-k6uuoen7wa-ue.a.run.app/auth/google/callback
# Optional. Used only when GOOGLE_REDIRECT_URI is unset:
# PUBLIC_BASE_URL=https://bakery-apply-k6uuoen7wa-ue.a.run.app

# Shop email on a new application (plain SMTP, e.g. Gmail app password).
# If SMTP_USER or SMTP_PASSWORD is unset, no mail is sent and apply still succeeds.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL=   # defaults to ADMIN_EMAIL

# Applicant receipt. Off unless this is exactly true AND SMTP_USER / SMTP_PASSWORD are set.
# ACK_EMAIL_ENABLED=true
